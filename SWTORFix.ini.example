; Copy to SWTORFix.ini beside SWTORFix.dll to override the defaults.
; A missing file, section or key leaves that job enabled.

[jobs]
; Hook ChangeDisplaySettingsEx so the client does not probe display modes.
BlockDisplayChanges=1

; Complete teleport-sized motion in a single frame (fixes teleport desync).
TeleportSnap=1

; Flush the combat log more often than the client's built-in 3 seconds.
LogFlush=1

[log]
; Combat log flush interval, in milliseconds. Clamped to 100..10000.
; The client's own default is 3000.
FlushMillis=1000

[teleport]
; Velocity above which motion is treated as a teleport, in units/s (1 unit = 0.1 m).
; Walking is ~0.4, teleports measure ~16.6. Clamped to 1..50.
; Raise this if a charge or leap is being caught and looks choppy.
MinVelocity=5

[debug]
; Report every snap decision through OutputDebugString, visible in DebugView.
; Off by default; turn on to check which motions the patch is firing on.
LogFires=0
